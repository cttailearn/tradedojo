# ===== TradeDojo 生产环境变量模板 =====
# 复制为 .env 并填写真实值(.env 已在 .gitignore 中)

# 必填: JWT 签名密钥(至少 32 字符强随机)
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
STOCK_SECRET_KEY=

# 必填(若 admin 用户首次创建): 默认管理员密码
STOCK_ADMIN_PASSWORD=

# 必填: 允许的跨域来源(逗号分隔;不要用 *,需要凭据时同源或具体域名)
STOCK_CORS_ORIGINS=https://your-domain.com

# 可选: Cookie 是否带 credentials(0/1)。开启时 CORS_ORIGINS 必须是具体域名
STOCK_CORS_CREDENTIALS=1

# 可选: 是否位于反代之后(影响限速 key 来源 + HSTS)
STOCK_BEHIND_PROXY=1

# 可选: 限速阈值(默认 10/minute 登录,5/minute 注册,300/minute 全局)
STOCK_LOGIN_RATE_LIMIT=10/minute
STOCK_REGISTER_RATE_LIMIT=5/minute
STOCK_GLOBAL_RATE_LIMIT=300/minute

# 可选: Token 有效期(分钟 / 天)
STOCK_TOKEN_EXPIRE_MINUTES=720
STOCK_REFRESH_TOKEN_EXPIRE_DAYS=7

# 可选: HSTS 最大秒数(默认 1 年)
STOCK_HSTS_MAX_AGE=31536000

# ===== 本地开发 =====
# STOCK_DEV=1            启用 dev 模式(自动生成临时 SECRET_KEY 与默认密码到 logs/DEV_ADMIN_PASSWORD.txt)
# STOCK_REQUIRE_PWD_CHANGE=1  首登强制改密(默认 1)
# STOCK_RATE_LIMIT=0     关闭限速
# STOCK_SECURITY_HEADERS=0 关闭安全响应头